# ===========================================================================
# 构建产物
# ===========================================================================

.gradle/
out/
bin/
# 任意层级的 build/ 都是产物（根目录 build/、app/build/、core/build/）
build/

# 本地下载的构建工具（Gradle 分发包等）
.tools/

# 三平台打包输出
build_windows/
build_linux/
build_macos/

# 发布产物（由 build_all / release 脚本收集到 dist/）
dist/

# ===========================================================================
# 运行期数据
#
# 这些是「便携模式就地运行」在仓库根目录留下的现场，必须带前导斜杠锚定到根目录：
# 不加斜杠时 git 会匹配任意层级的同名目录，`java/` 会把 app/src/main/java 与
# core/src/main/java 一起忽略掉 —— 那样提交里会一个 Java 源码都没有。
# ===========================================================================

/run/
/logs/
/config/
/java/
/instances/
/downloads/
/cache/
/temp/
/backgrounds/
/.minecraft/
/misaka.portable

# ===========================================================================
# 调试现场（崩溃报告、导出的崩溃信息、构建日志）
# ===========================================================================

*.log
crashreport.txt
minecraft-exported-crash-info-*/
hs_err_pid*.log
*.hprof

# ===========================================================================
# 工具与 IDE
# ===========================================================================

# CodeBuddy 的会话与项目数据，不纳入版本管理
.codebuddy/
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# ===========================================================================
# 系统
# ===========================================================================

.DS_Store
Thumbs.db

# ===========================================================================
# 凭据与本地环境（绝不入库）
#
# 仓库里不放任何真实凭据：Client ID / CurseForge Key 都在源码里留空，
# 由使用者在本地填写后构建。下面的规则只防「不小心把本地那份提交上去」。
# ===========================================================================

*.jks
*.keystore
*.p12
*.pem
*.key
.env
.env.*
local.properties
secrets.properties
# 便携模式在仓库根运行时可能留下含账号令牌的配置
/launcher.json

# 本地笔记：写成 *.local.md 的文件只留在自己机器上，永不入库
# （例如申请材料备忘、待办、调试记录 —— 这些不该出现在公开仓库里）
*.local.md
